<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.example.ai-filter-tgrelay</string>
  <key>ProgramArguments</key>
  <array>
    <string>__INSTALL_ROOT__/.venv/bin/python</string>
    <string>__INSTALL_ROOT__/scripts/tg_relay.py</string>
    
  </array>
  <key>WorkingDirectory</key><string>__INSTALL_ROOT__</string>
  <key>KeepAlive</key><true/><key>ThrottleInterval</key><integer>30</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__INSTALL_ROOT__/data/tg-relay.log</string>
  <key>StandardErrorPath</key><string>__INSTALL_ROOT__/data/tg-relay.log</string>
</dict>
</plist>
