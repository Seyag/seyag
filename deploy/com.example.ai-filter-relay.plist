<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.example.ai-filter-relay</string>
  <key>ProgramArguments</key><array>
    <string>__INSTALL_ROOT__/scripts/relay-pull-launch.sh</string>
  </array>
  <key>WorkingDirectory</key><string>__INSTALL_ROOT__</string>
  <!-- The launcher reads the home token from the login Keychain (dev.example.ai-filter.relay / home-token); never commit it. -->
  <key>StartInterval</key><integer>300</integer><key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__INSTALL_ROOT__/data/relay.log</string>
  <key>StandardErrorPath</key><string>__INSTALL_ROOT__/data/relay.log</string>
</dict></plist>
