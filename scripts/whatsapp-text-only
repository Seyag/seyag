#!/bin/bash
# Usage: whatsapp-text-only on|off|status  -- WhatsApp chats and calls stay; photos, videos, voice notes and files stop.
F="$(cd "$(dirname "$0")/.." && pwd)/data/whatsapp-text-only"
case "${1:-status}" in
  on) touch "$F"; echo "on (takes effect within 5 seconds)";;
  off) rm -f "$F"; echo "off";;
  status) [ -e "$F" ] && echo on || echo off;;
  *) echo "usage: $0 on|off|status" >&2; exit 2;;
esac
